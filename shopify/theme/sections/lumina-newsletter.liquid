<section class="bg-[#000] px-6 py-16 md:py-24 w-full"><div class="max-w-[1280px] mx-auto"><div class="rounded-[28px] border border-white/8 bg-white/[0.03] overflow-hidden"><div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_420px] items-center"><div class="px-6 py-8 md:px-10 md:py-10 lg:px-12 lg:py-12 border-b border-white/8 lg:border-b-0 lg:border-r border-white/8"><div class="max-w-[500px] flex flex-col gap-4"><p class="font-sans font-medium text-white/40 text-[12px] leading-4 tracking-[1.2px] uppercase">{{ section.settings.content_0 | escape }}</p><h2 class="font-playfair font-medium text-[#f9fafb] text-[36px] md:text-[48px] leading-tight md:leading-[48px]">{{ section.settings.heading | escape }}</h2><p class="font-sans text-white/58 text-[15px] leading-7 max-w-[420px]">{{ section.settings.description | escape }}</p></div></div><div class="px-6 py-8 md:px-8 md:py-10 lg:px-10 lg:py-12 bg-white/[0.02]"><div class="flex flex-col gap-5">{% form 'customer', id: 'LuminaNewsletter', class: 'flex flex-col gap-4' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="flex flex-col gap-2"><label for="newsletter-email" class="font-sans font-medium text-[#f9fafb] text-sm">{{ section.settings.content_1 | escape }}</label><input id="newsletter-email" type="email" autocomplete="email" required placeholder="Enter your email" class="w-full rounded-2xl border border-white/10 bg-white px-4 py-3.5 text-[15px] text-[#131720] outline-none transition-colors placeholder:text-[#8a94a6] focus:border-[#4051b5]" name="contact[email]"></div><button type="submit" class="bg-white text-[#131720] font-sans font-medium text-sm px-6 py-3.5 rounded-full transition-colors hover:bg-[#f3f4f6] disabled:cursor-not-allowed disabled:opacity-70">{{ section.settings.content_2 | escape }}</button>{% if form.posted_successfully? %}<p role="status" class="text-white">{{ section.settings.content_3 | escape }}</p>{% endif %}{{ form.errors | default_errors }}{% endform %}<p class="font-sans text-[12px] leading-5 text-white/40">{{ section.settings.content_4 | escape }}</p><div aria-live="polite" class></div></div></div></div></div></div></section>


{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe for 15% off."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Product updates, measuring guidance, and a 15% code for your first order."
    },
    {
      "type": "text",
      "id": "content_0",
      "label": "Email Updates",
      "default": "Email Updates"
    },
    {
      "type": "text",
      "id": "content_1",
      "label": "Email address",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "content_2",
      "label": "Subscribe",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "content_3",
      "label": "Thanks for subscribing.",
      "default": "Thanks for subscribing."
    },
    {
      "type": "text",
      "id": "content_4",
      "label": "By subscribing, you agree to receive email up",
      "default": "By subscribing, you agree to receive email updates from Lumina."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}